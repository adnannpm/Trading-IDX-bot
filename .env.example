# ==========================================
# Discord Bot Configuration
# ==========================================
# Token Bot Discord (Wajib)
DISCORD_TOKEN=your_bot_token_here

# Guild/Server ID untuk registrasi slash command instan di server tertentu (Opsional)
DISCORD_GUILD_ID=

# ==========================================
# Discord Channels (Market Scanner Broadcast)
# ==========================================
# Channel ID untuk broadcast Top 10 ARA / Gainers
TOP_ARA_CHANNEL_ID=1546695838779314226

# Channel ID untuk broadcast Top 10 ARB / Losers
TOP_ARB_CHANNEL_ID=1546695999748050944

# ==========================================
# Discord Roles (Aktivasi & Verifikasi User)
# ==========================================
# Role ID untuk membership tier VIP
ROLE_VIP_ID=1546438682276528168

# Role ID default untuk member yang terverifikasi
DEFAULT_MEMBER_ROLE_ID=1546692502785101874

# Role ID untuk member free / fallback saat subscription berakhir
FREE_ROLE_ID=1546692502785101874

# ==========================================
# Service & Database Configuration
# ==========================================
# Base URL API Laravel (Nusa Admin)
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1/agent

# Port untuk REST API lokal webhook
API_PORT=8080

# File path untuk database SQLite
DATABASE_PATH=nusa.db
